# ─────────────────────────────────────────────────────────────
#  Dynamic QR Code – Environment Variables
#  Copy this file to .env.local and fill in YOUR values.
#  NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (from your project Settings → API) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ── App URL (no trailing slash) ──────────────────────────────
# Local dev:       http://localhost:3000
# Production:      https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin credentials (stored securely – server-side only) ───
# Pick a strong password. This is hashed and compared server-side.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Session secret (random 32+ char string) ──────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string
